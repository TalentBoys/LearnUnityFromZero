# =====================
# Unity .gitignore
# =====================

# Unity 自动生成的缓存（最大的文件夹，几百MB到几GB）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Asset Import 自动生成
/[Aa]sset[Ss]tore[Tt]ools/

# Autogenerated Crash Reports
sysinfo.txt

# Build 产物
*.apk
*.aab
*.unitypackage
*.app

# =====================
# IDE / 编辑器
# =====================

# Visual Studio
.vs/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Solution 和 csproj（Unity 自动生成，不需要提交）
*.csproj
*.sln

# =====================
# OS 系统文件
# =====================
.DS_Store
Thumbs.db
desktop.ini

# =====================
# 其他
# =====================

# Gradle（Android 打包）
/[Ee]xport[Ee]d[Oo]bj/
.gradle/

# TextMesh Pro
/[Aa]ssets/TextMesh Pro/

# Plastic SCM
/ignore.conf
/.plastic/
